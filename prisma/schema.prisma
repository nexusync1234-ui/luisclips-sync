generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clipper {
  id           String           @id @default(cuid())
  username     String           @unique
  nickname     String
  avatar       String?
  bio          String?
  secUid       String?
  followers    Int              @default(0)
  totalLikes   Int              @default(0)
  videoCount   Int              @default(0)
  monthlyViews Int              @default(0)
  allTimeViews Int              @default(0)
  lastSyncedAt DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  clips        Clip[]
  history      ClipperHistory[]
}

model Clip {
  id             String   @id
  clipperId      String
  clipper        Clipper  @relation(fields: [clipperId], references: [id], onDelete: Cascade)
  title          String
  url            String
  coverUrl       String?
  viewCount      Int      @default(0)
  likeCount      Int      @default(0)
  commentCount   Int      @default(0)
  repostCount    Int      @default(0)
  duration       Int      @default(0)
  uploadDate     DateTime
  isCurrentMonth Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClipperHistory {
  id           String   @id @default(cuid())
  clipperId    String
  clipper      Clipper  @relation(fields: [clipperId], references: [id], onDelete: Cascade)
  followers    Int
  likes        Int
  monthlyViews Int
  recordedAt   DateTime @default(now())
}
